<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug APK only: gives adb an automation surface without touching the dashboard UI.
            The receiver forwards an explicit intent to the otherwise private runtime service.
        -->
        <receiver
            android:name=".debug.DriveDebugReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.gabrielpc.enginesoundsimulator.debug.CONTROL" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
